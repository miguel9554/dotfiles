function! LspDiagStatus() abort
    let l:enabled = get(b:, 'lsp_diagnostics_enabled',
          \ get(g:, 'lsp_diagnostics_enabled', 1))
    return l:enabled ? 'LSP:ON' : 'LSP:OFF'
endfunction

