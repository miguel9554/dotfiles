" Open LSP location in tab, reusing existing tab if buffer is already open
function! LspGotoTab(cmd) abort
    let l:orig_tab = tabpagenr()
    let l:orig_buf = bufnr('%')
    let l:orig_view = winsaveview()

    execute 'tab Lsp' . a:cmd

    let l:cur_tab = tabpagenr()
    let l:target_buf = bufnr('%')
    let l:target_line = line('.')
    let l:target_col = col('.')

    " If still in same tab (LSP found nothing or same file)
    if l:cur_tab == l:orig_tab
        return
    endif

    " Restore original tab's buffer if it was changed
    execute 'tabnext ' . l:orig_tab
    if bufnr('%') != l:orig_buf
        silent execute 'buffer ' . l:orig_buf
        call winrestview(l:orig_view)
    endif

    " Check if target buffer exists in another tab (besides the new one)
    let l:existing_tab = -1
    let l:existing_win = -1
    for l:tabnr in range(1, tabpagenr('$'))
        if l:tabnr == l:cur_tab
            continue
        endif
        let l:buflist = tabpagebuflist(l:tabnr)
        let l:idx = index(l:buflist, l:target_buf)
        if l:idx != -1
            let l:existing_tab = l:tabnr
            let l:existing_win = l:idx + 1
            break
        endif
    endfor

    if l:existing_tab != -1
        " Close the new tab and go to existing one
        execute 'tabclose ' . l:cur_tab
        if l:existing_tab > l:cur_tab
            let l:existing_tab -= 1
        endif
        execute 'tabnext ' . l:existing_tab
        execute l:existing_win . 'wincmd w'
        call cursor(l:target_line, l:target_col)
    else
        " Go back to the new tab
        execute 'tabnext ' . l:cur_tab
    endif
endfunction

